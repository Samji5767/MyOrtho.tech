# =============================================================================
# MyOrtho.tech — environment template
# Copy to `.env` and fill in real values. NEVER commit the populated .env file.
# `docker-compose.yml` reads these values at runtime.
# =============================================================================

# ---------- Database (PostgreSQL) ----------
# PostgreSQL is NOT published to the host — only reachable inside the Docker
# network at hostname "database". Do not expose port 5432 to the internet.
POSTGRES_USER=myortho_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=myortho_tech
DATABASE_URL=postgresql://myortho_admin:change_me_in_production@database:5432/myortho_tech
# Max pool connections per backend process (default 20 — reduce on low-memory VPS)
PG_POOL_MAX=20

# ---------- Cache (Redis) ----------
# Redis is NOT published to the host — only reachable inside the Docker network.
REDIS_URL=redis://redis:6379

# ---------- Backend (NestJS) ----------
BACKEND_PORT=4000
NODE_ENV=production
# Allowed CORS origin for the API. Set to your public frontend domain.
FRONTEND_URL=https://myortho.tech

# ---------- Frontend (Next.js) ----------
# Host port for the web app (container listens on 3000 internally).
FRONTEND_PORT=3005
# Public API base URL — the URL the browser uses to reach the backend.
NEXT_PUBLIC_API_URL=https://api.myortho.tech

# ---------- Security ----------
# Generate strong random secrets: openssl rand -hex 32
JWT_SECRET=change_me_generate_a_strong_secret
ENCRYPTION_KEY=change_me_32_byte_key_for_phi_at_rest
# Shared secret for internal backend ↔ AI engine calls (X-Internal-Token header).
INTERNAL_API_SECRET=change_me_generate_a_strong_secret

# ---------- Admin bootstrap ----------
# Bootstrap admin credentials — set ONCE before first deploy, then remove.
# The backend creates the admin account on startup if it does not exist.
MYORTHO_ADMIN_EMAIL=admin@myortho.tech
MYORTHO_ADMIN_PASSWORD=change_me_before_deploy
MYORTHO_ADMIN_NAME=Platform Admin

# ---------- Email (SMTP) ----------
# Required for email-verification and password-reset emails.
# Leave SMTP_HOST blank to suppress email (dev mode — emails printed to console).
SMTP_HOST=
SMTP_PORT=587
# Set SMTP_SECURE=true only for port 465 (SMTPS). Port 587 uses STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@myortho.tech
# Public-facing URL used inside email links. Must match the production domain.
APP_URL=https://myortho.tech

# ---------- AI Engine (FastAPI) ----------
# Host port for the AI engine (container listens on 8000 internally).
AI_ENGINE_PORT=8000
# "cpu" for VPS deployment. Set to "cuda" only if the host has a GPU and you
# add a GPU device reservation to docker-compose.yml.
AI_DEVICE=cpu
# Internal Docker URL used by the backend to call the AI engine.
AI_ENGINE_URL=http://ai-engine:8000

# ---------- AI Segmentation providers ----------
# Both external AI engines are BLOCKED until license / checkpoint blockers resolve.
# Keep TGN_ENABLED and MESHSEGNET_ENABLED=false for production.

# ToothGroupNetwork (TGN) — BLOCKED: CC BY-NC-ND 4.0 prohibits commercial use.
TGN_ENABLED=false
TGN_API_URL=

# MeshSegNet — BLOCKED: checkpoint not obtained; redistribution rights unconfirmed.
MESHSEGNET_ENABLED=false
MESHSEGNET_API_URL=

# Segmentation routing:
#   MANUAL   = skip all AI engines; route to manual clinical review (safe default)
#   AUTO     = try PRIMARY engine, then secondary, then MANUAL
#   TGN      = TGN only (fallback to MANUAL)
#   MESHSEGNET = MeshSegNet only (fallback to MANUAL)
SEGMENTATION_PROVIDER=MANUAL
SEGMENTATION_PRIMARY=TGN

# Path to trained model weights inside the AI engine container.
# Leave blank to run without AI inference (jobs will be queued for manual review).
MODEL_CHECKPOINT=

# Set to "true" to enable a rule-based fallback when MODEL_CHECKPOINT is absent.
# Output is flagged ai_version=0.0.0-rule-based-scaffold and requires clinician review.
# Never enable in production.
SEGMENTATION_FALLBACK_ENABLED=false

# ---------- Treatment plan AI ----------
# URL of a real biomechanical treatment-plan AI service.
# Leave blank to disable automated stage generation (recommended until real AI is integrated).
TREATMENT_PLAN_AI_URL=

# Set to "true" to enable deterministic pseudo-random stage scaffolding.
# All generated stages are flagged _is_simulated=true and blocked from approval/export.
# Never enable in production.
TREATMENT_PLAN_STAGE_FALLBACK_ENABLED=false

# ---------- Billing (Stripe) ----------
# Leave blank to run in free/mock mode (billing endpoints work, no charges).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
